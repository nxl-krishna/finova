generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  transactions Transaction[]
  budgets      Budget[]
  assets       Asset[]
  snapshots    NetWorthSnapshot[]
}

enum AccountType {
  ASSET
  LIABILITY
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType
  balance      Decimal       @db.Decimal(14, 2)
  transactions Transaction[]

  @@index([userId])
}

enum TxType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type        TxType
  category    String
  description String   @default("")
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime

  @@index([userId, date])
}

model Budget {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  limit    Decimal @db.Decimal(14, 2)

  @@unique([userId, category])
}

model Asset {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  name         String
  currentPrice Decimal      @db.Decimal(18, 4)
  trades       Trade[]
  prices       PricePoint[]

  @@unique([userId, symbol])
}

enum TradeSide {
  BUY
  SELL
}

model Trade {
  id       String    @id @default(cuid())
  assetId  String
  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  side     TradeSide
  quantity Decimal   @db.Decimal(18, 6)
  price    Decimal   @db.Decimal(18, 4)
  fee      Decimal   @default(0) @db.Decimal(14, 2)
  date     DateTime

  @@index([assetId, date])
}

model PricePoint {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date    DateTime
  price   Decimal  @db.Decimal(18, 4)

  @@unique([assetId, date])
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  assets      Decimal  @db.Decimal(14, 2)
  liabilities Decimal  @db.Decimal(14, 2)

  @@unique([userId, date])
}
